<template>
  <div class="page">
    <div class="header">
      <text class="title">תונעשוה</text>
      <text class="subtitle">ד״בח חסונ</text>
    </div>
    <list class="menu">
      <list-item for="{{items}}" class="item" type="menu" onclick="openItem($item.id)">
        <text class="item-text">{{ $item.title }}</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
import hoshanot from "../../common/hoshanot"

export default {
  private: {
    items: hoshanot
  },

  openItem(id) {
    router.push({
      uri: "/pages/detail",
      params: { dayId: id }
    })
  }
}
</script>

